# Copy this file to .env and fill in your real values.
# Never commit your real .env file to version control.

# ─────────────────────────────────────────────────────────
# DATABASE — required. PostgreSQL connection string.
# ─────────────────────────────────────────────────────────
# Local development (after installing PostgreSQL locally):
#   DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/aiplago
#
# Free hosted Postgres (recommended — pick one, all have a genuinely free tier):
#   Render Postgres:  https://render.com  (free for 30 days, then $7/mo OR re-create free instance)
#   Supabase:         https://supabase.com (free tier, no time limit)
#   Neon:             https://neon.tech    (free tier, no time limit)
# After creating a database on any of these, copy the connection string they
# give you and paste it below.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─────────────────────────────────────────────────────────
# AI PROVIDER — choose "github" (FREE) or "anthropic" (paid)
# ─────────────────────────────────────────────────────────
AI_PROVIDER=github

# ── If AI_PROVIDER=github (default, FREE — no payment needed) ──
# 1. Go to https://github.com/settings/tokens
# 2. Generate new token (classic) -> check the "models" scope -> Generate
# 3. Paste it below
GITHUB_TOKEN=your_api_key_here
GITHUB_MODEL=openai/gpt-4o-mini

# ── If AI_PROVIDER=anthropic (paid — requires billing on console.anthropic.com) ──
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─────────────────────────────────────────────────────────
# Required in production — use a long random string
# (this is NOT an external account, just make one up)
# ─────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string

# Port the backend listens on
PORT=6000

# Allowed origin for CORS. Use your real domain in production, e.g. https://aiplago.com
CORS_ORIGIN=*
